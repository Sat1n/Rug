<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Rug.Core.CSharp.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The native Rug.Core.dll is x64; force the test host to x64 to load it. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Rug.UI.Core\Rug.UI.Core.csproj" />
  </ItemGroup>

  <!-- Copy native Rug.Core.dll + its dependency DLLs (opencv_world, yaml-cpp,
       onnxruntime, ...) from the native build output so P/Invoke resolves at
       runtime. Build Rug.Core (x64) first. -->
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <NativeDll Include="$(MSBuildThisFileDirectory)..\..\x64\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\x64\$(Configuration)')" />
  </Target>

</Project>
