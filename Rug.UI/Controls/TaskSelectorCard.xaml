<UserControl
    x:Class="Rug.UI.Controls.TaskSelectorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" MinWidth="280">
        <StackPanel x:Name="TaskList" Spacing="4" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="全选" Click="SelectAll_Click" />
            <Button Content="清空" Click="Clear_Click" />
            <Button x:Name="StartButton" Content="开始执行" Click="Start_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
