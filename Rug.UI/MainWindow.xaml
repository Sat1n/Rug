<windowex:WindowEx
    x:Class="Rug.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rug.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    MinWidth="500"
    MinHeight="500"
    PersistenceId="MainWindow"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid RowDefinitions="*,Auto">
        <NavigationView x:Name="PluginNavigation" Grid.Row="0" PaneTitle="插件" Header="Rug 自动化"
                        IsSettingsVisible="False" SelectionChanged="PluginNavigation_SelectionChanged">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="开发工具" Tag="__devtools">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid>
                    <ContentControl x:Name="PluginContent"/>
                    <TextBlock x:Name="EmptyMessage" Text="正在扫描插件…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="人工接管" AutomationProperties.Name="Manual takeover" Click="ManualTakeover_Click"/>
                    <Button Content="交还控制" AutomationProperties.Name="Return control" Click="ReturnControl_Click"/>
                    <TextBlock x:Name="InputControlStatus" Text="自动化可用" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="InputDetectorStatus" Text="输入检测器尚未就绪" TextWrapping="Wrap"/>
                <TextBlock Text="输入任务运行期间，在其他窗口操作键鼠也会触发全局接管。"
                           Opacity="0.7" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="当前实例" VerticalAlignment="Center"/>
                    <ComboBox x:Name="InstancePicker" MinWidth="150" MaxWidth="250"
                              AutomationProperties.Name="当前实例"
                              SelectionChanged="InstancePicker_SelectionChanged"/>
                    <Button x:Name="NextInstanceButton" Content="下一个实例"
                            AutomationProperties.Name="Next instance"
                            Click="NextInstanceButton_Click"/>
                    <Button Content="插件权限" AutomationProperties.Name="Plugin permissions"
                            Click="PluginPermissions_Click"/>
                    <Button Content="运行绑定窗口任务" AutomationProperties.Name="Start bound task"
                            Click="StartBoundTask_Click"/>
                    <TextBlock x:Name="ReloadStatus" Text="监控中" Opacity="0.7"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="LifecycleStatus" Text="无运行实例" VerticalAlignment="Center"/>
                    <Button x:Name="PauseInstanceButton" Content="暂停" AutomationProperties.Name="Pause instance"
                            IsEnabled="False" Click="PauseInstance_Click"/>
                    <Button x:Name="ResumeInstanceButton" Content="恢复" AutomationProperties.Name="Resume instance"
                            IsEnabled="False" Click="ResumeInstance_Click"/>
                    <Button x:Name="VerifyRecoveryButton" Content="验证并继续" AutomationProperties.Name="Verify recovery"
                            IsEnabled="False" Click="VerifyRecovery_Click"/>
                    <Button x:Name="StopInstanceButton" Content="停止" AutomationProperties.Name="Stop instance"
                            IsEnabled="False" Click="StopInstance_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</windowex:WindowEx>
