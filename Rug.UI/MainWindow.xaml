<windowex:WindowEx
    x:Class="Rug.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rug.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    MinWidth="500"
    MinHeight="500"
    PersistenceId="MainWindow"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid RowDefinitions="*,Auto">
        <NavigationView x:Name="PluginNavigation" Grid.Row="0" PaneTitle="插件" Header="Rug 自动化"
                        IsSettingsVisible="False" SelectionChanged="PluginNavigation_SelectionChanged">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="开发工具" Tag="__devtools">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid>
                    <ContentControl x:Name="PluginContent"/>
                    <TextBlock x:Name="EmptyMessage" Text="正在扫描插件…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="当前实例" VerticalAlignment="Center"/>
                <ComboBox x:Name="InstancePicker" MinWidth="150" MaxWidth="250"
                          AutomationProperties.Name="当前实例"
                          SelectionChanged="InstancePicker_SelectionChanged"/>
                <Button x:Name="NextInstanceButton" Content="下一个实例"
                        AutomationProperties.Name="Next instance"
                        Click="NextInstanceButton_Click"/>
                <TextBlock x:Name="ReloadStatus" Text="监控中" Opacity="0.7"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</windowex:WindowEx>
