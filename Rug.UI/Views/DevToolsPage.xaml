<Page
    x:Class="Rug.UI.Views.DevToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Rug.UI.Helpers"
    xmlns:models="using:Rug.UI.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
    </Page.Resources>

    <Grid x:Name="ContentArea" RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">

        <!-- ============ Row 0: Crosshair picker + bound-window card ============ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Crosshair drag-to-pick (a Border, not a Button: Button swallows
                     PointerPressed/Released for its click handling, which would stop the
                     Spy++-style drag-capture from ever starting). -->
                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="CrosshairButton"
                            Width="72" Height="72"
                            HorizontalAlignment="Center"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="按住准星并拖到目标窗口，松开即绑定"
                            PointerPressed="Crosshair_PointerPressed"
                            PointerMoved="Crosshair_PointerMoved"
                            PointerReleased="Crosshair_PointerReleased"
                            PointerExited="Crosshair_PointerExited">
                        <Grid Width="44" Height="44" IsHitTestVisible="False">
                            <Ellipse Width="24" Height="24" StrokeThickness="2"
                                     Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <Rectangle Width="2" Height="44" HorizontalAlignment="Center"
                                       Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <Rectangle Width="44" Height="2" VerticalAlignment="Center"
                                       Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="准星取窗" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Bound window info -->
                <Grid Grid.Column="1" Margin="20,0,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HWND" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.BoundHwndText, Mode=OneWay}"
                               FontFamily="Consolas" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="标题" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BoundTitleText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="进程" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BoundProcessText, Mode=OneWay}"
                               Margin="0,0,0,2" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="尺寸" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.BoundSizeText, Mode=OneWay}" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="DPI" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.BoundDpiText, Mode=OneWay}" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="显示器" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.BoundMonitorText, Mode=OneWay}"
                               FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Input delivery mode -->
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="220">
                    <ToggleSwitch Header="输入投递方式"
                                  OnContent="后台 PostMessage"
                                  OffContent="前台 SendInput"
                                  IsOn="{x:Bind ViewModel.UseBackgroundInput, Mode=TwoWay}" />
                    <TextBlock x:Name="HoverText" Text="拖动准星到窗口以实时预览目标"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Row 1: Preview (left) + Input tests (right) ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- Preview panel -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto,*">

                    <!-- Preview toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                        <Button Command="{x:Bind ViewModel.TogglePreviewCommand}"
                                Content="{x:Bind ViewModel.PreviewToggleText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="130" />
                        <ToggleSwitch Header="OCR 叠加" OnContent="开" OffContent="关"
                                      IsOn="{x:Bind ViewModel.IsOcrOverlayEnabled, Mode=TwoWay}"
                                      MinWidth="120" />
                        <ComboBox Header="OCR 引擎" MinWidth="120"
                                  ItemsSource="{x:Bind ViewModel.OcrEngines}"
                                  SelectedItem="{x:Bind ViewModel.SelectedOcrEngine, Mode=TwoWay}" />
                        <ComboBox Header="Paddle 模型" MinWidth="180"
                                  IsEnabled="{x:Bind ViewModel.IsPaddleSelected, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.PaddleModelIds}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPaddleModelId, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Preview surface: Viewbox scales frame-space overlay with the image -->
                    <Border Grid.Row="1" Background="#FF101010" CornerRadius="6">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="PreviewRoot" Width="16" Height="9">
                                    <Image x:Name="PreviewImage" Stretch="Fill" />
                                    <Canvas x:Name="OverlayCanvas" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="未开启预览 —— 先绑定窗口，再点“开启实时预览”"
                                       Visibility="{x:Bind ToReverseVisibility(ViewModel.IsPreviewRunning), Mode=OneWay}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FF808080" FontSize="14" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="24" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Input test panel -->
            <Border Grid.Column="1" Width="300"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="输入测试控制台" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="所有测试发往已绑定窗口的客户区，鼠标被限制在窗口内。后台模式不抢焦点；前台模式会激活目标并移动真实光标。" />

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.TestMouseCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C9;" FontSize="16" />
                            <TextBlock Text="测试鼠标全功能" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="4,-6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="左 / 右 / 中 / 侧键 X1 / X2 点击 + 贝塞尔缓动拖拽" />

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.TestKeyboardCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE92E;" FontSize="16" />
                            <TextBlock Text="测试键盘按键覆盖" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="4,-6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="A-Z / 0-9 / 方向键 / Shift·Ctrl·Alt / F1-F12（屏蔽 Win·Fn）" />

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.StressTestCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                            <TextBlock Text="100 次全链路压测" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="4,-6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="截图 → OCR → 贝塞尔点击 闭环 ×100，结束强制 GC 并报告内存/句柄" />

                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  HorizontalAlignment="Center" Margin="0,4,0,0" />

                    <!-- Coordinate picker: drag onto the bound window to read a
                         client-space point for scripting. -->
                    <Border Margin="0,8,0,0" Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="坐标瞄准器（脚本取点）" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="按住下方准星拖到绑定窗口内的目标位置，松开即得到该点的客户区相对坐标，可直接用于脚本。" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border x:Name="CoordPicker" Width="56" Height="56"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="按住并拖到绑定窗口内取点"
                                        PointerPressed="CoordPicker_PointerPressed"
                                        PointerMoved="CoordPicker_PointerMoved"
                                        PointerReleased="CoordPicker_PointerReleased">
                                    <Grid Width="34" Height="34" IsHitTestVisible="False">
                                        <Ellipse Width="18" Height="18" StrokeThickness="2"
                                                 Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Rectangle Width="2" Height="34" HorizontalAlignment="Center"
                                                   Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Rectangle Width="34" Height="2" VerticalAlignment="Center"
                                                   Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="CoordHoverText" Text="实时: —"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PickedClientText, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <Button Content="复制坐标" Click="CopyCoord_Click" Padding="8,3" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ Row 2: Simulated console log ============ -->
        <Border Grid.Row="2" Height="220" Margin="0,12,0,0"
                Background="#FF1E1E1E" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8,12,8">
                    <TextBlock Grid.Column="0" Text="模拟控制台" Foreground="#FFCCCCCC"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="清空日志" Click="ClearLog_Click" Padding="8,4" FontSize="12" />
                        <Button Content="复制日志" Click="CopyLog_Click" Padding="8,4" FontSize="12" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="LogScroller" Grid.Row="1" Padding="12,0,12,8"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="12.5"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
