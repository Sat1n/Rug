<Page
    x:Class="Rug.UI.Views.DynamicUIHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentRoot" Spacing="12" Padding="24">
            <InfoBar x:Name="ErrorBanner" Severity="Error" IsOpen="False" />
            <StackPanel x:Name="DynamicContent" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
